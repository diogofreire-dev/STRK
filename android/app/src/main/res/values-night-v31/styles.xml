<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ usa a API de splash do sistema (ícone da app sobre uma
         cor), que ignora o launch_background. Aqui só lhe damos o fundo
         escuro da STRK para não aparecer um ecrã branco. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#0D0D0D</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
