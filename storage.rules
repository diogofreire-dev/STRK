rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de perfil: users/{uid}/profile_photo_<timestamp>.jpg|png
    match /users/{uid}/{fileName} {
      allow read: if isOwner(uid);

      // Separado do write: num delete o request.resource é null, por isso
      // as verificações de tamanho e tipo faziam falhar qualquer delete.
      allow delete: if isOwner(uid);

      allow create, update: if isOwner(uid)
        && fileName.matches('profile_photo_[0-9]+[.](jpg|png)')
        && request.resource.size < 5 * 1024 * 1024 // máx. 5MB
        && request.resource.contentType.matches('image/(jpeg|png)');
    }

    // Nega tudo o resto por omissão
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
  }
}
