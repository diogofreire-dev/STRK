rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Documento raiz do utilizador: users/{uid}
    // Guarda lastOpenDate, birthday, photoUrl, displayName e fcmToken.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(userFields())
        && isValidUser();
      // No update só olhamos para os campos que mudam: assim um campo antigo
      // que já exista no documento não bloqueia as escritas seguintes.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(userFields())
        && isValidUser();

      // Hábitos do utilizador: users/{uid}/habits/{habitId}
      match /habits/{habitId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidHabit(habitId);

        // Logs diários de um hábito: users/{uid}/habits/{habitId}/logs/{date}
        match /logs/{date} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && isValidLog(date);
        }
      }
    }

    // Nega tudo o resto por omissão (comportamento default do Firestore,
    // mas explícito aqui para clareza)
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Helpers ────────────────────────────────────────────────────────────

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isDateKey(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // A lista fechada de campos impede que alguém guarde dados arbitrários
    // (por exemplo, megabytes de lixo) através da API do Firestore.
    function userFields() {
      return ['lastOpenDate', 'birthday', 'photoUrl', 'displayName', 'fcmToken'];
    }

    function isValidUser() {
      let data = request.resource.data;
      return (!data.keys().hasAny(['lastOpenDate']) || isDateKey(data.lastOpenDate))
        && (!data.keys().hasAny(['birthday']) || isDateKey(data.birthday))
        && (!data.keys().hasAny(['photoUrl']) || data.photoUrl == null || data.photoUrl is string)
        && (!data.keys().hasAny(['displayName']) || data.displayName == null || data.displayName is string)
        && (!data.keys().hasAny(['fcmToken']) || data.fcmToken == null || data.fcmToken is string);
    }

    function isValidHabit(habitId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'name', 'icon', 'completedToday', 'streak'])
        && data.keys().hasOnly([
          'id', 'name', 'icon', 'completedToday', 'streak', 'lastCompletedDate',
          'reminderEnabled', 'reminderHour', 'reminderMinute', 'lastUpdated'
        ])
        && data.id == habitId
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.icon is string && data.icon.size() <= 30
        && data.completedToday is bool
        && data.streak is int && data.streak >= 0
        && (!data.keys().hasAny(['lastCompletedDate'])
            || data.lastCompletedDate == null
            || isDateKey(data.lastCompletedDate))
        && (!data.keys().hasAny(['reminderEnabled']) || data.reminderEnabled == null || data.reminderEnabled is bool)
        && (!data.keys().hasAny(['reminderHour']) || data.reminderHour == null || data.reminderHour is int)
        && (!data.keys().hasAny(['reminderMinute']) || data.reminderMinute == null || data.reminderMinute is int)
        && (!data.keys().hasAny(['lastUpdated']) || data.lastUpdated == request.time);
    }

    function isValidLog(date) {
      let data = request.resource.data;
      return data.keys().hasOnly(['completed', 'date'])
        && data.completed is bool
        && data.date == date
        && isDateKey(date);
    }
  }
}
